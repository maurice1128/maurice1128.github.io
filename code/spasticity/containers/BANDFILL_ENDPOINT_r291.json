 ],
 "window_note": "hipgap_r220.py's convention: cycles wholly inside [1.00, 9.73] s, drop the last, per-cycle mean ROM(l) - ROM(r) in degrees. Deposited as a field r308; previously stated only in prose.",
 "SPASTIC_CONDITION_COUNT_IS_CIRCULAR": {
  "finding": "The band [13.58, 17.85] s IS the observed t_end range of the six R151S KV 0.050 cells. Counting KV 0.050 as an in-band spastic condition is therefore true BY CONSTRUCTION -- those six cells define the interval they are then found inside, and 6 of 6 could not have come out any other way.",
  "counts": {
   "as_deposited_including_band_definer": 2,
   "NON_CIRCULAR": 1,
   "non_circular_condition": "KV 0.035 (one cell, R291KV0035_s103, t_end 17.77 s)",
   "band_defining_condition": "KV 0.050 (six R151S cells, 13.58-17.85 s)",
   "empty_condition": "KV 0.070 (six cells, 8.24-9.52 s, none in band)"
  },
  "consequence": "On a non-circular count the in-band spastic conditions number ONE, not two. GAP 2 is therefore FURTHER from closure than the deposited count of 2 of 3 implies: the registered target of three conditions is met by one independent condition plus the group that defined the band.",
  "why_recorded_anyway": "This weakens the arm and is deposited for that reason. COVERAGE_RECONCILE_r305.json already flags KV 0.050 as band-defining; this file did not, and a reader comparing the two would have found the stronger-looking count here.",
  "unchanged": "Reading A is unaffected -- its spastic group is the six R151S cells by registration, and the circularity concerns the COUNT OF CONDITIONS used to decide whether reading B is available, not the endpoint comparison itself."
 },
 "CORRECTION_r308_coverage_sentence": "The original sentence here read 'it reports 6 where the corpus has 8', with no time qualification. Both figures were mid-run values that the finished arm superseded. Time-qualified rather than deleted, so the earlier reconciliation remains traceable.",
 "CYCLE_COUNT_RECONCILIATION_D4_D5": {
  "D5_two_quantities_one_key": "'n_cycles' names DIFFERENT quantities in different files. In this file n_cycles is the count of gait cycles over the WHOLE trial and n_cycles_in_window is the count inside the measured window [1.00, 9.73] s. VERIFY_R290.json's n_cycles is the WINDOW count. For R151S_s101 this file reads n_cycles 13 / n_cycles_in_window 6 and VERIFY_R290.json reads n_cycles 6; the two agree, on the window count, for all 9 shared cells.",
  "RENAMED_IN_THIS_FILE": "n_cycles is hereby renamed n_cycles_whole_trial for clarity. The original key is retained alongside it so nothing that reads this file breaks and no deposited number is removed.",
  "D4_off_by_one_against_r277": "CONFOUND_DURATION_r277.json per_arm.S.cycles reads [12,11,9,12,10,10] for the same six R151S cells this file reports as [13,12,10,13,11,11] -- an offset of exactly one on every cell, with t_end matching exactly (17.85/14.96/13.58/16.94/14.27/14.82). The same offset appears on the weakness side: r277 reads 14 cycles at 20.0 s where MATCHED20_ENDPOINT_r298 reads 15.",
  "D4_status": "NOT RECONCILED. A constant offset of one is consistent with a differing cycle convention (counting completed cycles versus counting heel-strike intervals, or applying the drop-last rule versus not), but which file uses which convention is not recorded in either, and no deposit states the definition. This is recorded as an open discrepancy rather than resolved by assertion.",
  "what_it_does_and_does_not_affect": "Disjointness of the cycle-count comparison holds on EITHER set, so no conclusion flips. But RESULTS_3d_r214.md sec0c the anchored passage relies on this quantity ('Cycle count separates the same way'), and a reader checking that sentence against the two deposits finds two different numbers for the same cells with nothing explaining it. [r333: A line number into RESULTS_3d_r214.md is stale on arrival -- that file has been edited more than a dozen times in the last day. Content anchors survive edits that line numbers cannot. Replaced r333; prior wording preserved above.]",
  "CONVENTION_IDENTIFIED_r308": {
   "convention_A_lower": "SPEED_LADDER_r217.json and CONFOUND_DURATION_r277.json",
   "convention_B_higher_by_one": "PERCYCLE_r279.json, BANDFILL_ENDPOINT_r291.json and MATCHED20_ENDPOINT_r298.json",
   "cross_check": "PERCYCLE_r279.json per_cell.S.101.n_cycles = 13, siding with convention B.",
   "ADOPTED": "Convention B is adopted as the project's cycle count, because three deposits use it including the per-cycle source file, against two that use A.",
   "no_conclusion_changes": "Disjointness of the cycle-count comparison holds under both."
  },
  "what_it_does_and_does_not_affect_LINE_CITATION_SUPERSEDED_r333": "Disjointness of the cycle-count comparison holds on EITHER set, so no conclusion flips. But RESULTS_3d_r214.md sec0c line 134 relies on this quantity ('Cycle count separates the same way'), and a reader checking that sentence against the two deposits finds two different numbers for the same cells with nothing explaining it."
 },
 "GAP_1_STATED_BASIS_NOT_MET_D29": {
  "registration_says": "PREREG_bandfill_r291.md sec7: 'With 8 weakness and 12+ spastic in band the floor falls well below 1/84, which is what closes GAP 1.'",
  "what_happened": "Reading A's spastic side is SIX, not 12+. The weakness side reached 11, exceeding the 8 named. The floor did fall as predicted -- 1/12376 against the 1/84 benchmark -- so the substance of GAP 1's closure holds.",
  "why_this_is_recorded": "The stated BASIS was not met even though the stated OUTCOME was. A reader comparing sec7 to this deposit would find the spastic count short by half with no acknowledgement. GAP 1 is reported closed on the floor actually achieved, not on the composition sec7 anticipated."
 },
 "status_ORIGINAL_WRONG": "CONFIRMATORY. The r291 arm stopped on its registered 60-cell cap (section 5's second clause, the only one that could fire). Endpoint computed only after.",
 "COVERAGE_METHOD_ORIGINAL_WRONG": "Measured from .sto over the corpus per SO-27. No launcher counter was consulted. run_bandfill_r291.py's coverage() skips deposits lacking a t_end_s key and is blind to 30 r276/r285 cells. AS OF THIS FILE (arm complete, 60 of 60 cells) the corpus count is 11 in-band weakness cells and the launcher counter read 7. The figures '6' and '8' that appear in COVERAGE_RECONCILE_r305.json are a SNAPSHOT taken mid-run at 48 of 60 cells and are correct only for that moment; they are not this arm's final counts.",
 "CORRECTION_r321_snapshot_count": "This field previously said the mid-run snapshot was taken at 48 of 60 cells. The correct value is 47, which is what COVERAGE_RECONCILE_r305.json's own r291_cells_deposited_at_write field records. The r311 repair fixed 48->47 in that file and left 48 live here, so one quantity had two live values across two deposits for a further round.",
 "LINE_CITATION_ANCHORED_r333": {
  "anchor": "the passage beginning \"Cycle count separates the same way\" in RESULTS_3d_r214.md sec0c (content anchor, not a line number)",
  "why": "A line number into RESULTS_3d_r214.md is stale on arrival -- that file has been edited more than a dozen times in the last day. Content anchors survive edits that line numbers cannot. Replaced r333; prior wording preserved above.",
  "fields_changed": 1
 }
